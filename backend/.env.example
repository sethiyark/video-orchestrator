# Optional overrides. Defaults run locally in mock mode with SQLite.
# Export variables or pass --env-file .env to uvicorn.
APP_ENV=development
PIPELINE_MODE=mock
RUN_WORKER=true
# DATABASE_URL=postgresql+psycopg://video:video_local_dev@localhost:5432/video_orchestrator
# DATABASE_URL=sqlite:////absolute/path/to/jobs.sqlite3
# DATABASE_PATH is still supported when DATABASE_URL is unset.
# MODEL_CONFIG=/absolute/path/to/models.yaml
# MODEL_CACHE_DIR=/absolute/path/to/models
# ARTIFACT_DIR=/absolute/path/to/artifacts
# HF_TOKEN=your_read_token_for_gated_models
CORS_ORIGINS=http://localhost:3091,http://127.0.0.1:3091
# REDIS_URL=redis://127.0.0.1:6379/0
# TEMPORAL_TARGET=127.0.0.1:7233
STORAGE_BACKEND=local
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=video-artifacts
LOG_FORMAT=text
